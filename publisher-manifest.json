x-end;justify-content:space-between;gap:16px;padding-bottom:20px;border-bottom:1px solid var(--line)}\n  .plan-name{font-size:22px;font-weight:700;display:flex;align-items:center;gap:12px;flex-wrap:wrap}\n  .tag{font-size:11px;letter-spacing:.14em;background:var(--brown);color:var(--mint);padding:3px 9px;font-weight:600;letter-spacing:.18em}\n  .plan-price{text-align:right;line-height:1.4}\n  .plan-price .amount{font-size:26px;font-weight:700;letter-spacing:.01em}\n  .plan-price .year{display:block;font-size:13px;color:var(--muted);margin-top:2px}\n  .plan-list{margin-top:20px;display:grid;gap:9px}\n  .plan-list li{font-size:14.5px;padding-left:20px;position:relative;color:#3c2c22}\n  .plan-list li::before{content:\"\";position:absolute;left:0;top:.72em;width:9px;height:2px;background:var(--mint-deep)}\n  .plans-foot{margin-top:16px;font-size:13px;color:var(--muted)}\n\n  .clients{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 56px}\n  .client{padding:22px 0;border-top:1px solid var(--line)}\n  .client h3{font-size:16px;margin-bottom:8px}\n  .client p{font-size:14.5px;color:#4a382d}\n  .client .meta{margin-top:8px;font-size:12.5px;color:var(--muted);letter-spacing:.03em}\n  .clients-note{margin-top:30px;font-size:13px;color:var(--muted);max-width:46em}\n\n  .faq{display:grid;gap:0;max-width:820px}\n  details{border-bottom:1px solid var(--line)}\n  details:first-of-type{border-top:1px solid var(--line)}\n  summary{cursor:pointer;list-style:none;padding:20px 40px 20px 0;position:relative;font-size:16px;font-weight:600;line-height:1.6}\n  summary::-webkit-details-marker{display:none}\n  summary::after{content:\"+\";position:absolute;right:6px;top:50%;transform:translateY(-50%);font-size:20px;font-weight:400;color:var(--mint-deep);line-height:1}\n  details[open] summary::after{content:\"—\";font-size:16px}\n  details p{padding:0 40px 22px 0;font-size:14.5px;color:#4a382d;max-width:44em}\n\n  .closing{background:var(--brown);color:#e9ddd0;padding:64px 0}\n  .closing-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:44px;align-items:start}\n  .closing h2{color:#fff;font-size:clamp(21px,2.8vw,27px)}\n  .closing p{margin-top:14px;font-size:14.5px;color:#c3b1a0;max-width:34em}\n  .closing-links{display:grid;gap:12px;font-size:14px}\n  .closing-links a{text-decoration:none;color:var(--mint);border-bottom:1px solid rgba(143,227,194,.35);padding-bottom:2px;width:fit-content}\n  .closing-links a:hover{color:#fff;border-bottom-color:#fff}\n\n  @media (max-width:900px){\n    .hero-grid{grid-template-columns:1fr;gap:40px}\n    .usage{grid-template-columns:1fr;gap:32px}\n    .clients{grid-template-columns:1fr;gap:0}\n    .closing-grid{grid-template-columns:1fr;gap:28px}\n    .sec-head{grid-template-columns:1fr;gap:10px}\n  }\n  @media (max-width:640px){\n    .hero{padding:44px 0 52px}\n    section{padding:54px 0}\n    .plan{padding:24px 20px}\n    .plan-top{flex-direction:column;align-items:flex-start}\n    .plan-price{text-align:left}\n    .topbar-inner{font-size:12px;gap:10px 16px}\n    .panel{padding:22px 18px 18px}\n  }\n</style><div class=\"topbar\">\n  <div class=\"topbar-inner\">\n    <div class=\"topbar-brand\">cappuccino</div>\n    <nav class=\"topbar-nav\" aria-label=\"页面目录\">\n      <a href=\"#usage\">使用说明</a>\n      <a href=\"#plans\">套餐结构</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</div>\n\n<main>\n\n  <section class=\"hero\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <span class=\"eyebrow\">SUBSCRIPTION NOTES / 订阅说明</span>\n        <h1 id=\"brand-title\">cappuccino\n          <span class=\"thin\">先读说明，再做选择</span>\n        </h1>\n        <p class=\"hero-lead\">\n          这是一个以文档方式组织的订阅页面。我们不使用夸张的形容，只把每一档包含的流量额度、可同时使用的设备数量、线路类型与支持方式逐条写清楚。\n          <strong>你在决定之前，应该能看懂自己买的是什么。</strong>\n        </p>\n        <p class=\"hero-note\">\n          本页所有价格为参考展示值，套餐权益以套餐区块所列条目为准。页面不提供账号注册、支付或下载操作，实际情况请以官方渠道的说明为依据。\n        </p>\n      </div>\n      <aside class=\"panel\" aria-label=\"概要信息\">\n        <div class=\"panel-title\">Quick Reference</div>\n        <dl>\n          <div class=\"panel-row\">\n            <dt>套餐数量</dt>\n            <dd>三档：基础版 / 旗舰版 / 团队版</dd>\n          </div>\n          <div class=\"panel-row\">\n            <dt>计费方式</dt>\n            <dd>按月或按年，两种周期</dd>\n          </div>\n          <div class=\"panel-row\">\n            <dt>设备上限</dt>\n            <dd>3 / 5 / 20 台，按档位递增</dd>\n          </div>\n          <div class=\"panel-row\">\n            <dt>流量额度</dt>\n            <dd>100GB / 300GB / 1000GB 每月</dd>\n          </div>\n          <div class=\"panel-row\">\n            <dt>客户端</dt>\n            <dd>桌面端、移动端、路由器配置</dd>\n          </div>\n        </dl>\n        <div class=\"panel-foot\">\n          说明：以上为套餐条目的概括，完整条目请阅读下方“套餐结构”一节；设备数量指同时在线数量上限。\n        </div>\n      </aside>\n    </div>\n  </section>\n\n  <section id=\"usage\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"sec-num\">01 / 使用说明</div>\n        <div>\n          <h2 id=\"usage-title\">从订阅到日常使用，分三步走</h2>\n          <p class=\"sec-sub\">这里描述的是使用流程的结构，而不是操作教程。每一步都以“你需要先确认什么”为前提。</p>\n        </div>\n      </div>\n      <div class=\"usage\">\n        <div>\n          <h3><span>STEP 1</span>确认需求</h3>\n          <p>先数清你有多少台设备需要同时在线，再估算每月的流量消耗。设备数量与流量额度是两件不同的事，套餐里分别列出，不要混为一谈。</p>\n          <p>如果只是偶尔在手机和笔记本之间切换，基础版的 3 台上限通常已经够用；如果需要覆盖家庭多设备或小团队协作，则应直接看团队版。</p>\n        </div>\n        <div>\n          <h3><span>STEP 2</span>选择周期</h3>\n          <p>每档都提供按月与按年两种周期，按年支付的年费为月费乘以十。也就是说，按年付相当于支付十个月的费用。</p>\n          <p>年付适合长期使用者；如果你对线路类型或设备数量还不确定，先用月付观察一个周期更稳妥。</p>\n        </div>\n        <div>\n          <h3><span>STEP 3</span>配置客户端</h3>\n          <p>订阅生效后，在设备上安装对应客户端并按说明完成配置。桌面端、移动端与路由器三种场景的处理方式不同，具体见“客户端”一节。</p>\n          <p>同时在线设备数达到上限后，新设备将无法连接，此时需要断开其他设备或升级档位。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"sec-num\">02 / 套餐结构</div>\n        <div>\n          <h2 id=\"plans-title\">三档套餐，逐条列出所含内容</h2>\n          <p class=\"sec-sub\">按档位从低到高依次排列。价格为参考展示值，按年付的年费为对应月费的十倍。</p>\n        </div>\n      </div>\n\n      <div class=\"plans\">\n\n        <article class=\"plan\">\n          <div class=\"plan-top\">\n            <div class=\"plan-name\">基础版</div>\n            <div class=\"plan-price\">\n              <span class=\"amount\">¥15 / 月</span>\n              <span class=\"year\">按年付 ¥150 / 年</span>\n            </div>\n          </div>\n          <ul class=\"plan-list\">\n            <li>每月 100GB 流量额度</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"plan featured\">\n          <div class=\"plan-top\">\n            <div class=\"plan-name\">旗舰版 <span class=\"tag\">推荐</span></div>\n            <div class=\"plan-price\">\n              <span class=\"amount\">¥35 / 月</span>\n              <span class=\"year\">按年付 ¥350 / 年</span>\n            </div>\n          </div>\n          <ul class=\"plan-list\">\n            <li>每月 300GB 流量额度</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan\">\n          <div class=\"plan-top\">\n            <div class=\"plan-name\">团队版</div>\n            <div class=\"plan-price\">\n              <span class=\"amount\">¥85 / 月</span>\n              <span class=\"year\">按年付 ¥850 / 年</span>\n            </div>\n          </div>\n          <ul class=\"plan-list\">\n            <li>每月 1000GB 流量额度</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n\n      </div>\n\n      <p class=\"plans-foot\">\n        以上条目即套餐的全部说明内容。页面不承诺具体带宽数值、节点数量或延迟表现，此类信息不在本页的描述范围内。\n      </p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"sec-num\">03 / 客户端</div>\n        <div>\n          <h2 id=\"clients-title\">按设备类型分别处理</h2>\n          <p class=\"sec-sub\">不同系统的配置方式差异较大，以下按场景说明适用范围与注意事项。</p>\n        </div>\n      </div>\n\n      <div class=\"clients\">\n        <div class=\"client\">\n          <h3>桌面端（Windows / macOS）</h3>\n          <p>适合单人日常使用，通常占用一个同时在线名额。安装后需手动导入订阅信息并选择线路，建议将常用线路固定，避免频繁切换。</p>\n          <p class=\"meta\">占用名额：1 台 · 适用档位：全部</p>\n        </div>\n        <div class=\"client\">\n          <h3>移动端（iOS / Android）</h3>\n          <p>系统对后台连接的管理较为严格，切换网络后可能需要重新连接。手机与平板各计一台，共享同一账号时请注意同时在线总数。</p>\n          <p class=\"meta\">占用名额：1 台 / 设备 · 适用档位：全部</p>\n        </div>\n        <div class=\"client\">\n          <h3>路由器配置</h3>\n          <p>在路由器侧配置后，接入该路由器的设备均可使用，但路由器本身通常计为一个连接点。此方式更适合固定场所，不建议与移动设备混用同一套配置。</p>\n          <p class=\"meta\">占用名额：按路由器计 · 适用档位：旗舰版、团队版更合适</p>\n        </div>\n        <div class=\"client\">\n          <h3>浏览器与临时环境</h3>\n          <p>浏览器扩展或临时环境一般同样计入设备数。若只是短期使用，建议在使用完毕后主动断开，避免占满名额导致其他设备无法连接。</p>\n          <p class=\"meta\">占用名额：视实现而定 · 适用档位：全部</p>\n        </div>\n      </div>\n\n      <p class=\"clients-note\">\n        本页不提供客户端下载地址或安装包来源；相关文件的获取方式请以官方渠道公布的信息为准。上文所述为配置逻辑层面的说明，不对具体版本号作出承诺。\n      </p>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"sec-num\">04 / 常见问题</div>\n        <div>\n          <h2 id=\"faq-title\">关于套餐与使用的问题</h2>\n          <p class=\"sec-sub\">点击问题展开答案。以下回答仅针对本页所列的套餐条目，不涉及未在本页出现的内容。</p>\n        </div>\n      </div>\n\n      <div class=\"faq\">\n\n        <details>\n          <summary>流量额度和设备数量是同一个限制吗？</summary>\n          <p>不是。流量额度指每月的传输总量上限，设备数量指可同时保持连接的设备台数。两者分别计算：流量用尽与设备超额是两种不同的限制情形，不会互相替代。</p>\n        </details>\n\n        <details>\n          <summary>按年付能省多少？</summary>\n          <p>年费为对应月费的十倍，也就是按年支付相当于支付十个月的费用，其余两个月不计费。三档套餐均按此规则：¥150、¥350、¥850。</p>\n        </details>\n\n        <details>\n          <summary>超出同时在线设备数会怎样？</summary>\n          <p>达到上限后，新的设备通常无法建立连接。此时可以选择断开当前不使用的设备，或升级到设备上限更高的档位。基础版为 3 台，旗舰版为 5 台，团队版为 20 台。</p>\n        </details>\n\n        <details>\n          <summary>普通线路与 IPLC 专线有什么区别？</summary>\n          <p>本页仅说明档位配置差异：基础版使用普通线路节点池，旗舰版在条目中列有 IPLC 专线游戏加速优化，团队版列有 VIP 专属高带宽节点。具体线路表现不属于本页描述范围，页面不提供测速或延迟数据。</p>\n        </details>\n\n        <details>\n          <summary>团队版的“企业定制路由”指什么？</summary>\n          <p>该条目表示团队版支持按企业网络结构进行路由层面的调整。本页不展开具体实施方式，也不承诺任何交付周期或实施范围，实际以官方沟通结果为准。</p>\n        </details>\n\n        <details>\n          <summary>使用过程中遇到问题找谁？</summary>\n          <p>旗舰版条目包含 7×24 优先工单支持，团队版条目包含专属客户经理服务。基础版未在条目中列出优先支持，具体支持渠道请以官方说明为准。本页不提供客服联系方式或工单入口。</p>\n        </details>\n\n        <details>\n          <summary>能中途更换套餐或周期吗？</summary>\n          <p>本页不对变更、退订或结算规则作出说明，因为相关规则不在已提供的信息范围内。建议在决定前按当前需求选择周期，并向官方渠道确认变更条件。</p>\n        </details>\n\n        <details>\n          <summary>本页的价格是最终价格吗？</summary>\n          <p>本页价格为参考展示值，用于说明三档套餐之间的相对关系。页面不包含支付环节，也不对任何交易作出承诺。实际价格与生效条件请以官方渠道公布的信息为准。</p>\n        </details>\n\n      </div>\n    </div>\n  </section>\n\n  <div class=\"closing\">\n    <div class=\"wrap closing-grid\">\n      <div>\n        <h2>说明到此为止，选择权在你</h2>\n        <p>cappuccino 的这一页只做一件事：把套餐条目、设备数量与客户端场景讲清楚。页面不提供注册、支付与下载入口，也不对未列出的信息作出推断。</p>\n        <p>如果你已经确认了设备数量与所需档位，可返回上方“套餐结构”一节复核条目。</p>\n      </div>\n      <nav class=\"closing-links\" aria-label=\"页内跳转\">\n        <a href=\"#usage\">回到使用说明</a>\n        <a href=\"#plans\">回到套餐结构</a>\n        <a href=\"#clients\">回到客户端说明</a>\n        <a href=\"#faq\">回到常见问题</a>\n      </nav>\n    </div>\n  </div>\n\n</main>",
